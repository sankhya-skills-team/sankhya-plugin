	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Nº único da nota (TGFCAB.NUNOTA)]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAB.NUNOTA, CAB.NUMNOTA, CAB.SERIENOTA, CAB.DTNEG, CAB.TIPMOV, CAB.VLRNOTA, CAB.OBSERVACAO,
       EMP.NOMEFANTASIA AS NOMEEMP,
       PAR.CODPARC, PAR.NOMEPARC, PAR.RAZAOSOCIAL, PAR.CGC_CPF, CID.NOMECID, UFS.UF,
       ITE.SEQUENCIA, ITE.CODPROD, PRO.DESCRPROD, PRO.REFERENCIA, ITE.CODVOL, ITE.QTDNEG, ITE.VLRUNIT, ITE.VLRTOT,
       GRU.CODGRUPOPROD, GRU.DESCRGRUPOPROD
  FROM TGFCAB CAB
  JOIN TSIEMP EMP ON EMP.CODEMP = CAB.CODEMP
  JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
  LEFT JOIN TSICID CID ON CID.CODCID = PAR.CODCID
  LEFT JOIN TSIUFS UFS ON UFS.CODUF = CID.UF
  JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA
  JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
  JOIN TGFGRU GRU ON GRU.CODGRUPOPROD = PRO.CODGRUPOPROD
 WHERE CAB.NUNOTA = $P{PK_NUNOTA}
 ORDER BY GRU.DESCRGRUPOPROD, ITE.SEQUENCIA]]>
	</queryString>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="SERIENOTA" class="java.lang.String"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="TIPMOV" class="java.lang.String"/>
