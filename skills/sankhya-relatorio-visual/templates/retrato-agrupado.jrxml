	</variable>
	<variable name="V_ITENS" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{SEQUENCIA}]]></variableExpression>
	</variable>
	<group name="GRUPO" isReprintHeaderOnEachPage="true" minHeightToStartNewPage="60">
