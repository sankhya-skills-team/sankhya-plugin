				<textFieldExpression class="java.lang.String"><![CDATA[$F{CGC_CPF} == null || $F{CGC_CPF}.trim().length() == 0 ? "-" : ($F{CGC_CPF}.trim().length() == 14 ? $F{CGC_CPF}.trim().replaceAll("(\\d{2})(\\d{3})(\\d{3})(\\d{4})(\\d{2})", "$1.$2.$3/$4-$5") : ($F{CGC_CPF}.trim().length() == 11 ? $F{CGC_CPF}.trim().replaceAll("(\\d{3})(\\d{3})(\\d{3})(\\d{2})", "$1.$2.$3-$4") : $F{CGC_CPF}.trim()))]]></textFieldExpression>
