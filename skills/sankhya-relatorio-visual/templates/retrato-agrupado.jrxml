				<textFieldExpression class="java.lang.String"><![CDATA[($F{NOMEEMP} == null ? "" : $F{NOMEEMP}) + ($F{SERIENOTA} == null ? "" : ($F{NOMEEMP} == null ? "" : " · ") + "série " + $F{SERIENOTA})]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Tarja" x="449" y="3" width="90" height="16">
