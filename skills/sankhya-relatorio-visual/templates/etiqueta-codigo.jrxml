<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EtiquetaProduto" language="java" pageWidth="595" pageHeight="842" columnWidth="539" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28" whenNoDataType="NoDataSection">
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="dstech.padrao.visual" value="sankhya-relatorio-visual 1.0.0"/>
	<style name="Base" isDefault="true" fontName="Calibri" fontSize="10" forecolor="#1F2933"/>
	<style name="EtqTitulo" fontName="Calibri" fontSize="11" isBold="true" forecolor="#2E3C50" vAlign="Middle"/>
	<style name="EtqCodigo" fontName="Calibri" fontSize="28" isBold="true" forecolor="#1F2933" vAlign="Middle"/>
	<style name="EtqDescricao" fontName="Calibri" fontSize="12" isBold="true" forecolor="#2E3C50" hAlign="Center" vAlign="Middle"/>
	<style name="EtqEmissao" fontName="Calibri" fontSize="7" forecolor="#4A5563" vAlign="Middle"/>
	<parameter name="PK_CODPROD" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Código do produto (TGFPRO.CODPROD)]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT PRO.CODPROD, PRO.DESCRPROD, PRO.REFERENCIA, PRO.CODVOL, PRO.MARCA
  FROM TGFPRO PRO
 WHERE PRO.CODPROD = $P{PK_CODPROD}]]>
	</queryString>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="REFERENCIA" class="java.lang.String"/>
	<field name="CODVOL" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<variable name="V_LOGO" class="java.awt.Image" calculation="System">
		<initialValueExpression><![CDATA[javax.imageio.ImageIO.read(new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode("")))]]></initialValueExpression>
	</variable>
	<variable name="V_SELO" class="java.awt.Image" calculation="System">
		<initialValueExpression><![CDATA[javax.imageio.ImageIO.read(new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode("")))]]></initialValueExpression>
	</variable>
	<variable name="V_CODIGO" class="java.lang.String" calculation="Nothing">
		<variableExpression><![CDATA[$F{REFERENCIA} != null && $F{REFERENCIA}.trim().length() > 0 ? $F{REFERENCIA}.trim().toUpperCase() : ($F{CODPROD} == null ? "" : $F{CODPROD}.toPlainString())]]></variableExpression>
	</variable>
	<detail>
		<band height="262" splitType="Prevent">
			<rectangle radius="8">
				<reportElement x="0" y="0" width="539" height="196" forecolor="#2E3C50" backcolor="#FFFFFF"/>
				<graphicElement>
					<pen lineWidth="1.25" lineColor="#2E3C50"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement style="EtqTitulo" x="16" y="8" width="380" height="17"/>
				<textElement/>
				<text><![CDATA[PRODUTO]]></text>
			</staticText>
			<image scaleImage="RetainShape" hAlign="Right" vAlign="Middle" onErrorType="Blank">
				<reportElement x="433" y="9" width="90" height="14"/>
				<imageExpression class="java.awt.Image"><![CDATA[$V{V_LOGO}]]></imageExpression>
			</image>
			<line>
				<reportElement x="16" y="27" width="507" height="1" forecolor="#66CB66"/>
				<graphicElement>
					<pen lineWidth="1.0" lineColor="#66CB66"/>
				</graphicElement>
			</line>
			<componentElement>
				<reportElement x="16" y="34" width="507" height="72">
					<printWhenExpression><![CDATA[Boolean.valueOf($V{V_CODIGO} != null && $V{V_CODIGO}.length() > 0)]]></printWhenExpression>
				</reportElement>
				<jr:barbecue xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" type="Code128" drawText="false" checksumRequired="false" barWidth="2" barHeight="70">
					<jr:codeExpression><![CDATA[$V{V_CODIGO}]]></jr:codeExpression>
				</jr:barbecue>
			</componentElement>
			<textField isBlankWhenNull="true">
				<reportElement style="EtqCodigo" x="16" y="108" width="507" height="38">
					<property name="net.sf.jasperreports.text.truncate.suffix" value="…"/>
				</reportElement>
				<box leftPadding="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$V{V_CODIGO}]]></textFieldExpression>
			</textField>
			<rectangle radius="4">
				<reportElement x="10" y="150" width="519" height="38" forecolor="#EEF2F5" backcolor="#EEF2F5"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>
			<textField isBlankWhenNull="true">
				<reportElement style="EtqDescricao" x="16" y="152" width="507" height="34">
					<property name="net.sf.jasperreports.text.truncate.suffix" value="…"/>
				</reportElement>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[($F{CODPROD} == null ? "" : $F{CODPROD}.toPlainString()) + ($F{DESCRPROD} == null ? "" : ($F{CODPROD} == null ? "" : " · ") + $F{DESCRPROD}) + ($F{CODVOL} == null ? "" : " · " + $F{CODVOL}) + ($F{MARCA} == null || $F{MARCA}.trim().length() == 0 ? "" : " · " + $F{MARCA}.trim())]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
				<reportElement x="4" y="200" width="38" height="9"/>
				<imageExpression class="java.awt.Image"><![CDATA[$V{V_SELO}]]></imageExpression>
			</image>
			<textField>
				<reportElement style="EtqEmissao" x="250" y="200" width="289" height="10"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Emitido em " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date()) + "  ·  página " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<noData>
		<band height="30">
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="0" width="539" height="20" forecolor="#2E3C50"/>
				<textElement>
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Produto " + ($P{PK_CODPROD} == null ? "" : $P{PK_CODPROD}.toPlainString()) + " não encontrado."]]></textFieldExpression>
			</textField>
		</band>
	</noData>
</jasperReport>
