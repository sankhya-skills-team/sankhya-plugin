	<parameter name="P_DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Vencimento de]]></parameterDescription>
	</parameter>
	<parameter name="P_DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Vencimento até]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT FIN.NUFIN, FIN.CODEMP, FIN.NUMNOTA, FIN.DTNEG, FIN.DTVENC, FIN.DHBAIXA, FIN.RECDESP,
       FIN.VLRDESDOB, FIN.VLRBAIXA, FIN.CODPARC, PAR.NOMEPARC, FIN.CODNAT, NAT.DESCRNAT, FIN.HISTORICO
  FROM TGFFIN FIN
  JOIN TGFPAR PAR ON PAR.CODPARC = FIN.CODPARC
  LEFT JOIN TGFNAT NAT ON NAT.CODNAT = FIN.CODNAT
 WHERE FIN.DTVENC BETWEEN $P{P_DTINI} AND $P{P_DTFIN}
   AND FIN.RECDESP <> 0
 ORDER BY FIN.DTVENC, FIN.NUFIN]]>
	</queryString>
	<field name="NUFIN" class="java.math.BigDecimal"/>
	<field name="CODEMP" class="java.math.BigDecimal"/>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="DTVENC" class="java.sql.Timestamp"/>
	<field name="DHBAIXA" class="java.sql.Timestamp"/>
	<field name="RECDESP" class="java.math.BigDecimal"/>
	<field name="VLRDESDOB" class="java.math.BigDecimal"/>
	<field name="VLRBAIXA" class="java.math.BigDecimal"/>
	<field name="CODPARC" class="java.math.BigDecimal"/>
	<field name="NOMEPARC" class="java.lang.String"/>
	<field name="CODNAT" class="java.math.BigDecimal"/>
	<field name="DESCRNAT" class="java.lang.String"/>
	<field name="HISTORICO" class="java.lang.String"/>
	<variable name="V_MOEDA" class="java.text.DecimalFormat" calculation="System">
		<initialValueExpression><![CDATA[new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("pt", "BR")))]]></initialValueExpression>
	</variable>
	<variable name="V_DATA" class="java.text.SimpleDateFormat" calculation="System">
		<initialValueExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy")]]></initialValueExpression>
	</variable>
	<variable name="V_HOJE" class="java.lang.String" calculation="System">
		<initialValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyyMMdd").format(new java.util.Date())]]></initialValueExpression>
	</variable>
	<variable name="V_LOGO" class="java.awt.Image" calculation="System">
		<initialValueExpression><![CDATA[javax.imageio.ImageIO.read(new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode("")))]]></initialValueExpression>
	</variable>
	<variable name="V_SELO" class="java.awt.Image" calculation="System">
		<initialValueExpression><![CDATA[javax.imageio.ImageIO.read(new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode("")))]]></initialValueExpression>
	</variable>
	<variable name="V_PAGINA" class="java.lang.Integer" resetType="Page">
		<variableExpression><![CDATA[$V{PAGE_NUMBER}]]></variableExpression>
	</variable>
	<variable name="V_TITULOS" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{NUFIN}]]></variableExpression>
	</variable>
	<variable name="V_RECEBER" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{RECDESP} != null && $F{RECDESP}.signum() > 0 && $F{DHBAIXA} == null && $F{VLRDESDOB} != null ? $F{VLRDESDOB} : java.math.BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="V_PAGAR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{RECDESP} != null && $F{RECDESP}.signum() < 0 && $F{DHBAIXA} == null && $F{VLRDESDOB} != null ? $F{VLRDESDOB} : java.math.BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="V_VENCIDOS" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[Integer.valueOf($F{DHBAIXA} == null && $F{DTVENC} != null && new java.text.SimpleDateFormat("yyyyMMdd").format($F{DTVENC}).compareTo($V{V_HOJE}) < 0 ? 1 : 0)]]></variableExpression>
	</variable>
